menu "SUMP Capture"

    choice SUMP_TRANSPORT
        prompt "OLS transport (serial interface)"
        default SUMP_TRANSPORT_USB
        help
            Select which serial interface carries the SUMP/OLS protocol.

            *** RECOMMENDED: USB Serial JTAG ***

            USB mode: OLS on USB Serial JTAG (typically COM7).
                      PulseView connects here via OLS driver.
                      Console on UART0 (typically COM6).

            UART mode: OLS on UART0 (typically COM6).
                       CAUTION: When PulseView opens a COM port it
                       asserts DTR/RTS, which on ESP32 dev boards are
                       wired to EN (reset) and BOOT.  This causes a
                       hardware reset.  The ROM bootloader then prints
                       boot text at 115200 baud, which PulseView reads
                       as garbage at 921600 baud and concludes nothing
                       is connected.  Use USB mode instead, or install
                       a 10uF cap between EN and GND to suppress the
                       reset.

            IMPORTANT: also change ESP Console setting to match:
              USB mode   -> CONFIG_ESP_CONSOLE_UART_DEFAULT (console on UART0)
              UART mode  -> CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG (console on USB JTAG)

        config SUMP_TRANSPORT_USB
            bool "USB Serial JTAG (Recommended)"
            help
                OLS protocol uses USB Serial JTAG (typically COM7).
                This is the recommended mode because the native USB
                peripheral does not route through a USB-UART bridge,
                so opening the port never triggers a hardware reset.
                PulseView connects here via the OLS driver.
                IDF console routes to UART0 (typically COM6).

        config SUMP_TRANSPORT_UART
            bool "UART0 (DTR reset risk -- not recommended)"
            help
                OLS protocol uses UART0 (typically COM6).
                WARNING: PulseView will toggle DTR when opening this
                port, causing the ESP32 to reset.  The ROM bootloader
                boot text will then corrupt the SUMP handshake.  To
                use this mode you MUST either:
                  (a) install a 10uF capacitor on EN->GND, or
                  (b) use the DTR reset guard (CONFIG_SUMP_DTR_RESET_GUARD).
                USB Serial JTAG mode avoids this entirely.

    endchoice

    config SUMP_UART_BAUD
        int "UART console / fallback baud rate"
        default 15200
        range 9600 3000000
        help
            Baud rate used when the SUMP transport is set to UART0,
            and also the baud rate of the UART console in USB mode.

            When using USB Serial JTAG mode this controls the IDF
            console on UART0 (the "UART" port).  PulseView does NOT
            use this -- it talks over USB -- so it has no effect on the
            SUMP handshake in USB mode.

            When using UART0 mode this is the SUMP/OLS baud rate.
            MUST match the baud rate you select in PulseView.

    config SUMP_CLOCK_FREQ
        int "SUMP reference clock frequency (Hz)"
        default 240000000
        help
            Reference clock frequency for SUMP divider calculation.
            Sample rate = clock_freq / (divider + 1).

    config SUMP_MAX_SAMPLES
        int "Maximum samples per channel"
        default 100000
        range 1000 4000000
        help
            Maximum number of samples per channel in the capture buffer.
            With timer ISR, raw samples are packed 8 per byte in ISR.
            Memory = (MAX_SAMPLES / 8) * num_channels bytes.

    config SUMP_NUM_CHANNELS
        int "Number of SUMP channels (1 or 2)"
        default 2
        range 1 2
        help
            Number of channels to capture.
            1 = GDO0 only (demodulated async data).
            2 = GDO0 + GDO2 (configurable second signal).

    config SUMP_GDO2_MODE
        int "GDO2 output mode (IOCFG2 register value)"
        default 13
        range 0 47
        help
            CC1101 IOCFG2 output mode for the 2nd SUMP channel.
            Common values:
              0x06 = Sync word detect (packet timing reference)
              0x07 = CRC OK (data quality indicator)
              0x08 = PLL lock (carrier detect)
              0x0B = RSSI valid (signal presence)
              0x0D = Async data (raw demodulated bits, same as GDO0)
              0x2E = High-Z (disabled, 1-channel mode)

            The GDO2 GPIO pin is NOT a SUMP option: capture_init() is
            called with PIN_NUM_GDO2, which comes from CONFIG_CC1101_PIN_GDO2
            (hw_init.h / cc1101 Kconfig).  A former SUMP_GDO2_PIN option was
            removed -- it duplicated the cc1101 pin and was never read by
            the code, so changing it silently had no effect.

    config SUMP_DTR_RESET_GUARD
        bool "DTR/RTS reset guard (software)"
        default y
        help
            When PulseView opens a serial port it toggles DTR/RTS,
            which on many ESP32 dev boards resets the chip via the
            CH340/CP2102 bridge.  The ROM bootloader then prints boot
            text at 115200 baud that corrupts the SUMP handshake at
            921600 baud.  This guard drains the serial buffer for an
            extended period after boot to absorb the stale output.
            RECOMMENDED: use USB Serial JTAG mode instead -- it avoids
            the DTR reset entirely because it bypasses the bridge chip.

    config SUMP_DTR_GUARD_MS
        int "Guard drain time (ms)"
        default 3000
        range 500 10000
        depends on SUMP_DTR_RESET_GUARD
        help
            How long to drain the serial buffer after USB JTAG driver
            install, before entering the SUMP command loop.  The ROM
            bootloader prints ~300 bytes of boot text; at 921600 baud
            that takes about 4 ms, but we also need margin for the
            host to open the port.  3000 ms is safe; lower values
            risk missing the first SUMP command.

endmenu
