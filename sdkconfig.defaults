CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# OLS transport: USB Serial JTAG (COM7) for PulseView, UART0 (COM6) for console
CONFIG_SUMP_TRANSPORT_USB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Console baud rate
CONFIG_SUMP_UART_BAUD=115200

# Enable IDF logs on UART0 (COM6) for debugging
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Release (-O2) for ISR timing headroom: the 250 kHz gptimer capture ISR
# (sump_capture) has ~4 us per sample; -Og (debug) leaves too little margin.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# GDO pins moved to avoid USB Serial/JTAG conflict (GPIO 3/4)
CONFIG_CC1101_PIN_GDO0=10
CONFIG_CC1101_PIN_GDO2=11
